# =============================================================
# TN-LawMaster Environment Variables — Copy to .env and fill in
# DO NOT commit .env to version control
# =============================================================

# ── Backend Selection ──────────────────────────────────────
# Options: ollama | groq | openai | openrouter
# Ollama requires a locally running Ollama server.
ACTIVE_BACKEND=ollama

# ── Ollama (Local) ────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:1b   # Options: gemma3:1b, gemma2:2b, llama3.2:3b

# ── Groq (Cloud — fast free tier) ────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-70b-8192  # Options: llama3-70b-8192, mixtral-8x7b-32768

# ── OpenAI ───────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini  # Options: gpt-4o, gpt-4o-mini, gpt-4-turbo

# ── OpenRouter ───────────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=mistralai/mistral-7b-instruct  # Any OpenRouter-supported model

# ── Application ──────────────────────────────────────────
LOG_LEVEL=INFO
DATA_DIR=./data
CHROMA_DB_PATH=./chroma_db
TCA_DB_PATH=./data/tca.db

# ── API Server ───────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
# For production, restrict CORS to your actual frontend domain:
CORS_ORIGINS=http://localhost:3000,http://localhost:8501

# ── Observability (Optional) ─────────────────────────────
SENTRY_DSN=your_sentry_dsn_here
