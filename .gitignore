# =============================================================
# TN-LawMaster .gitignore
# =============================================================

# --- SECURITY: NEVER commit secrets ---
.env
.env.local
.env.*.local
secrets.json
credentials.json
*_key.txt
*_secret.txt

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg
.eggs/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# --- Testing ---
.pytest_cache/
.coverage
htmlcov/
.tox/
*.test.db

# --- Vector / Database stores ---
chroma_db/
faiss_index/
*.db
*.sqlite
*.sqlite3
tca_index/

# --- Data (raw law texts can be large) ---
data/tca_raw/
data/pdfs/
data/*.pdf
data/*.txt
data/*.json
# Keep the empty data/ dir tracked via .gitkeep
!data/.gitkeep

# --- Logs ---
logs/
*.log
log/

# --- OS-specific ---
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# --- IDEs ---
.idea/
.vscode/
*.swp
*.swo
*~
*.code-workspace

# --- Junk / scratch files ---
trending.html
scratch/
*.html.bak

# --- Docker build artifacts ---
.docker/

# --- Node (if any frontend tooling) ---
node_modules/
npm-debug.log*
